# Copiar a .env y ajustar. NUNCA subir .env al repositorio.
DATABASE_URL=postgresql+psycopg2://biofactory:biofactory_dev@localhost:5432/biofactory
# Para pruebas rápidas sin Postgres: DATABASE_URL=sqlite:///./biofactory.db
SECRET_KEY=cambia-esto-por-una-cadena-aleatoria-de-64-caracteres
ACCESS_TOKEN_MINUTES=480
RESET_TOKEN_MINUTES=30
# En producción: DEV_MODE=false (no devuelve el token de recuperación en la respuesta)
DEV_MODE=true
CORS_ORIGINS=http://localhost:5173
